{
  "code": "esop-cancellation-record-sync",
  "name": "ESOP / Cancellation Records Sync",
  "description": "读取取消与恢复报表的「取消与恢复明细」，并替换取消记录展示数据。",
  "status": "active",
  "version": 5,
  "tasks": [
    {
      "x": 48,
      "y": 48,
      "id": "extract_cancellation_records",
      "name": "Extract Cancel & Restore Detail",
      "inputs": {},
      "params": {
        "range": "A1:W",
        "fileRef": {
          "$type": "object",
          "$label": "Cancel & Restore Report workbook",
          "$fromRuntime": "fileRefs.cancellation_report"
        },
        "headerRow": 1,
        "sheetName": "取消与恢复明细",
        "dropTrailingEmptyRows": true,
        "emptyColumns": "姓名, 工号, 牛牛号, 员工邮箱, 手机号, 证件号, 在职状态, 授予编号, 激励类型, 所属计划, 授予日期, 授予数量, 授予价(USD), 创建日期(GMT+8), 创建编号, 归属日期, 财务变更日期, 变更日期, 变更类型, 取消/恢复原因, 数量, 归属规则, 操作人"
      },
      "dependsOn": [],
      "description": "从取消与恢复报表提取「取消与恢复明细」Sheet（23 列中文表头，第 1 行表头）。 该输入为可选：未提供时输出空 dataframe，月度运行不会因此中断（记录页该月显示为空）。 未提供文件时按 emptyColumns 输出空表，供下游合并使用。",
      "operatorCode": "sheet.optional-range.extract",
      "operatorVersion": "1.0.0"
    },
    {
      "x": 284,
      "y": 48,
      "id": "filter_cancellation_records_rows",
      "name": "Filter Cancellation Record Rows",
      "inputs": {
        "input1": {
          "from": "extract_cancellation_records",
          "slot": "dataframe"
        }
      },
      "params": {
        "sql": "select *\nfrom {cancellation_records}\nwhere trim(concat('', coalesce([工号], ''))) <> ''\n  and trim(concat('', coalesce([姓名], ''))) <> ''\n  and trim(concat('', coalesce([工号], ''))) <> '工号'",
        "tableBindings": [
          {
            "inputSlot": "input1",
            "tableName": "cancellation_records"
          }
        ]
      },
      "dependsOn": [],
      "description": "过滤报表顶部空行、说明行和表头噪音，只保留有员工工号和姓名的记录。",
      "operatorCode": "sql.compute",
      "operatorVersion": "1.0.0"
    },
    {
      "id": "extract_cancellation_records_base",
      "name": "Extract cancellation_records base",
      "operatorCode": "sheet.optional-range.extract",
      "operatorVersion": "1.0.0",
      "description": "读取上一月的累计快照作为 base；未提供时输出空表，合并结果即当月增量。",
      "dependsOn": [],
      "inputs": {},
      "x": 48,
      "y": -160,
      "params": {
        "range": "A1:AZ50000",
        "fileRef": {
          "$type": "object",
          "$label": "cancellation_records base",
          "$default": {},
          "$fromRuntime": "fileRefs.base_cancellation_records"
        },
        "headerRow": 1,
        "sheetName": "Cancellation Records",
        "dropTrailingEmptyRows": true,
        "emptyColumns": "姓名, 工号, 牛牛号, 员工邮箱, 手机号, 证件号, 在职状态, 授予编号, 激励类型, 所属计划, 授予日期, 授予数量, 授予价(USD), 创建日期(GMT+8), 创建编号, 归属日期, 财务变更日期, 变更日期, 变更类型, 取消/恢复原因, 数量, 归属规则, 操作人"
      }
    },
    {
      "id": "merge_cancellation_records_records",
      "name": "Merge cancellation_records records",
      "operatorCode": "dataframe.keyed.merge",
      "operatorVersion": "1.0.0",
      "description": "按 创建编号 幂等合并 base 与本月增量：同键以增量覆盖，base 独有的行保留（历史不丢）。",
      "dependsOn": [],
      "inputs": {
        "base": {
          "from": "extract_cancellation_records_base",
          "slot": "dataframe",
          "guards": []
        },
        "increment": {
          "from": "filter_cancellation_records_rows",
          "slot": "dataframe",
          "guards": []
        }
      },
      "x": 228,
      "y": -160,
      "params": {
        "keyColumns": [
          "创建编号"
        ],
        "outputColumns": [
          "姓名",
          "工号",
          "牛牛号",
          "员工邮箱",
          "手机号",
          "证件号",
          "在职状态",
          "授予编号",
          "激励类型",
          "所属计划",
          "授予日期",
          "授予数量",
          "授予价(USD)",
          "创建日期(GMT+8)",
          "创建编号",
          "归属日期",
          "财务变更日期",
          "变更日期",
          "变更类型",
          "取消/恢复原因",
          "数量",
          "归属规则",
          "操作人"
        ],
        "conflictPolicy": "increment-wins",
        "incomingBlankPolicy": "preserve",
        "emitAuditColumns": false
      }
    },
    {
      "x": 520,
      "y": 48,
      "id": "persist_cancellation_records_file",
      "name": "Persist Cancellation Records File",
      "inputs": {
        "input1": {
          "from": "merge_cancellation_records_records",
          "slot": "dataframe"
        }
      },
      "params": {
        "fileName": "cancellation_records.xlsx",
        "sheetName": "Cancellation Records",
        "sourceKey": "cancellation_report",
        "uploadedBy": "Workflow",
        "folderPrefix": "output/cancellation-record",
        "fileNameSuffix": {
          "$fromRuntime": "monthUnderscore"
        }
      },
      "dependsOn": [],
      "description": "将取消与恢复明细输出为 Excel 文件，展示层读取最新成功执行的输出文件。 输出文件名带月份后缀，便于在 Files 中辨认当月快照。 输入为 base 与本月的幂等合并结果，即截至当月的累计快照。",
      "operatorCode": "dataframe.persist.excel",
      "operatorVersion": "1.0.0"
    }
  ],
  "runtimeParamsSchema": {
    "fileRefs": {
      "type": "object",
      "label": "File References",
      "properties": {
        "cancellation_report": {
          "type": "object",
          "label": "Cancel & Restore Report workbook"
        },
        "base_cancellation_records": {
          "type": "object",
          "label": "Base · Cancellation Records (上月快照)",
          "description": "上一月累计快照；月度运行自动带入，留空时即当月增量本身。",
          "required": false
        }
      }
    },
    "month": {
      "type": "string",
      "label": "Month",
      "description": "月度快照键（YYYY-MM）。展示层按该值取当月最新快照，并写入输出文件名后缀。"
    },
    "monthUnderscore": {
      "type": "string",
      "label": "Month (underscore)",
      "description": "month 的下划线形式（YYYY_MM），用于输出文件名后缀。"
    }
  },
  "runtimeParamsDefaults": {}
}

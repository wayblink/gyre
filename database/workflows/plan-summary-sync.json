{
  "code": "plan-summary-sync",
  "name": "Plan Summary Sync",
  "description": "读取 Gyre Option Plans Summary SL，并消费取消与恢复报表增量合并后的完整基表；计划级指标由 plan-summary-metrics 计算（Cancelled 按报表「所属计划」逐计划覆盖，Outstanding 由 Granted + Exercised + Cancelled 重算），本工作流只负责把结果落成 Plan_Summary.xlsx。",
  "status": "active",
  "version": 8,
  "tasks": [
    {
      "x": 420,
      "y": 80,
      "id": "invoke_plan_summary_metrics",
      "name": "Calculate Plan Summary Metrics",
      "inputs": {},
      "params": {
        "outputTaskId": "aggregate_plan_summary",
        "workflowCode": "plan-summary-metrics",
        "runtimeParameters": {
          "fileRefs": {
            "option_plans_summary": {
              "$type": "object",
              "$label": "Gyre Option Plans Summary SL workbook",
              "$default": {
                "sheet": "!Option Plans Summary (Post-Gyr"
              },
              "$fromRuntime": "fileRefs.option_plans_summary"
            },
            "base_cancel_restore_report": {
              "$type": "object",
              "$label": "Base Cancel & Restore Report workbook",
              "$default": {
                "sheet": "取消与恢复明细"
              },
              "$fromRuntime": "fileRefs.base_cancel_restore_report"
            },
            "incremental_cancel_restore_report": {
              "$type": "object",
              "$label": "Cancel & Restore Detail",
              "$default": {
                "sheet": "取消与恢复明细"
              },
              "$fromRuntime": "fileRefs.incremental_cancel_restore_report"
            }
          }
        },
        "inheritRuntimeParameters": true
      },
      "dependsOn": [],
      "description": "调用 Plan Summary Metrics 子工作流，按本次业务月份计算计划级指标（Outstanding 由三列重算）。",
      "operatorCode": "workflow.invoke",
      "operatorVersion": "1.0.0"
    },
    {
      "x": 960,
      "y": 80,
      "id": "persist_plan_summary_file",
      "name": "Persist Plan Summary File",
      "inputs": {
        "input1": {
          "from": "invoke_plan_summary_metrics",
          "slot": "dataframe",
          "guards": []
        }
      },
      "params": {
        "fileName": "Plan_Summary.xlsx",
        "sheetName": "Plan Summary",
        "uploadedBy": "Workflow",
        "folderPrefix": "output/plan-summary",
        "fileNamePrefix": {
          "$fromRuntime": "month"
        }
      },
      "dependsOn": [],
      "description": "将 Plan Summary dataframe 输出为 Excel 文件，业务页面读取最新成功执行的输出文件渲染。",
      "operatorCode": "dataframe.persist.excel",
      "operatorVersion": "1.0.0"
    }
  ],
  "runtimeParamsSchema": {
    "month": {
      "type": "string",
      "label": "Month",
      "description": "用于生成月度输出文件名前缀，例如 2026-05-Capitalization_Table_Summary_View.xlsx。"
    },
    "fileRefs": {
      "type": "object",
      "label": "fileRefs",
      "properties": {
        "option_plans_summary": {
          "type": "object",
          "label": "Gyre Option Plans Summary SL workbook",
          "required": true,
          "properties": {
            "sheet": {
              "type": "string",
              "label": "Sheet"
            }
          }
        },
        "base_cancel_restore_report": {
          "type": "object",
          "label": "Base Cancel & Restore Report workbook",
          "hidden": true,
          "required": false,
          "properties": {
            "sheet": {
              "type": "string",
              "label": "Base sheet"
            }
          }
        },
        "incremental_cancel_restore_report": {
          "type": "object",
          "label": "Cancel & Restore Detail",
          "required": true,
          "properties": {
            "sheet": {
              "type": "string",
              "label": "Increment sheet"
            }
          }
        }
      }
    },
    "monthUnderscore": {
      "type": "string",
      "label": "Month (underscore)",
      "description": "用于合并基表月度输出文件名。"
    }
  },
  "runtimeParamsDefaults": {
    "month": "2026-09",
    "fileRefs": {
      "option_plans_summary": {
        "sheet": "!Option Plans Summary (Post-Gyr"
      },
      "base_cancel_restore_report": {
        "sheet": "取消与恢复明细"
      },
      "incremental_cancel_restore_report": {
        "sheet": "取消与恢复明细"
      }
    },
    "monthUnderscore": "2026_09"
  }
}

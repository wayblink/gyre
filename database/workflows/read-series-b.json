          "from": "assert_series_b_schema",
          "slot": "dataframe",
          "guards": []
        }
      },
      "params": {
        "sql": "select sum(coalesce([Shares Issued], 0)) as [Shares Issued Total] from {series_b}",
        "tableBindings": [

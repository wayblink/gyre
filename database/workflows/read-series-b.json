      "operatorVersion": "1.0.0"
    },
    {
      "x": 900,
      "y": 180,
      "id": "persist_series_b_base",
      "name": "Persist merged SERIES B base",
      "inputs": {
        "control_book": {
          "from": "merge_series_b_control_book",
          "slot": "dataframe",
          "guards": []
        }
      },
      "params": {
        "fileName": "SeriesB_Control_Book_Base.xlsx",
        "folderPrefix": "series_b",
        "fileNameSuffix": {
          "$fromRuntime": "monthUnderscore"
        },
        "versionedOutput": false,
        "conflictPolicy": "overwrite",
        "uploadedBy": "Workflow",
        "sheets": [
          {
            "inputSlot": "control_book",
            "sheetName": "Series B Control Book",
            "headerRow": 1,
            "columnFormats": {
              "As of Date": "dd\\-mmm\\-yyyy",
              "Process Date": "dd\\-mmm\\-yyyy"
            }
          }
        ]
      },
      "dependsOn": [],
      "description": "\u628a\u5408\u5e76\u540e\u7684\u7d2f\u79ef\u660e\u7ec6\u5199\u6210 series_b/SeriesB_Control_Book_Base_yyyy_MM.xlsx\uff08\u540c\u6708\u8986\u76d6\uff09\uff0c\u4e0b\u6708\u7531\u6708\u5ea6\u89e6\u53d1\u6d41\u7a0b\u6309\u6708\u4efd\u81ea\u52a8\u5b9a\u4f4d\u4e3a base\u3002",
      "operatorCode": "workbook.persist.excel",
      "operatorVersion": "1.0.0"
    },
    {
      "x": 460,
      "y": 460,
      "id": "summarize_increment_totals",
      "name": "Summarize increment totals",
      "inputs": {
        "increment": {
          "from": "extract_series_b_increment",
          "slot": "dataframe",
          "guards": []
        }
      },
      "params": {
        "sql": "select coalesce(sum(coalesce([Shares Issued], 0)), 0) as total_issued, coalesce(sum(coalesce([Shares Retired], 0)), 0) as total_retired from {increment}",
        "tableBindings": [
          {
            "inputSlot": "increment",
            "tableName": "increment"
          }
        ]
      },
      "dependsOn": [],
      "description": "\u5f53\u6708\u660e\u7ec6\u7684\u53d1\u884c/\u9000\u4f11\u5408\u8ba1\uff0c\u7528\u4e8e\u548c 43105 \u6c47\u603b\u5bf9\u8d26\u3002",
      "operatorCode": "sql.compute",
      "operatorVersion": "1.0.0"
    },
    {
      "x": 460,
      "y": 640,
      "id": "summarize_rollup_totals",
      "name": "Summarize 43105 rollup totals",
      "inputs": {
        "rollup": {
          "from": "extract_series_b_rollup",
          "slot": "dataframe",
          "guards": []
        }
      },
      "params": {
        "sql": "select coalesce(sum(coalesce([Shares Issued], 0)), 0) as total_issued, coalesce(sum(coalesce([Shares Retired], 0)), 0) as total_retired from {series_b_rollup}",
        "tableBindings": [
          {
            "inputSlot": "rollup",
            "tableName": "series_b_rollup"
          }
        ]
      },
      "dependsOn": [],
      "description": "43105 \u6c47\u603b sheet \u7684\u53d1\u884c/\u9000\u4f11\u5408\u8ba1\u3002",
      "operatorCode": "sql.compute",
      "operatorVersion": "1.0.0"
    },
    {
      "x": 900,
      "y": 520,
      "id": "assert_series_b_reconciliation",
      "name": "Assert detail matches 43105 rollup",
      "inputs": {
        "increment_totals": {
          "from": "summarize_increment_totals",
          "slot": "dataframe",
          "guards": []
        },
        "rollup_totals": {
          "from": "summarize_rollup_totals",
          "slot": "dataframe",
          "guards": []
        }
      },
      "params": {
        "sql": "select case when coalesce(i.total_issued, 0) = coalesce(r.total_issued, 0) and coalesce(i.total_retired, 0) = coalesce(r.total_retired, 0) then 1 else 0 end as actual from {increment_totals} i, {rollup_totals} r",
        "tableBindings": [
          {
            "inputSlot": "increment_totals",
            "tableName": "increment_totals"
          },
          {
            "inputSlot": "rollup_totals",
            "tableName": "rollup_totals"
          }
        ],
        "operator": "=",
        "expectedValue": 1,
        "failureMessage": "SERIES B \u660e\u7ec6 sheet \u4e0e 43105 \u6c47\u603b sheet \u7684 Shares Issued / Shares Retired \u5408\u8ba1\u4e0d\u4e00\u81f4\uff1a\u4e24\u4efd sheet \u4e0d\u662f\u540c\u4e00\u6b21\u5bfc\u51fa\u7684\u540c\u4e00\u4efd\u6570\u636e\uff0c\u7981\u6b62\u7528\u8fd9\u4efd\u6587\u4ef6\u7d2f\u79ef\uff08\u4f1a\u6c61\u67d3 base\uff09\u3002",
        "failureStrategy": "block"
      },
      "dependsOn": [],
      "description": "\u7528 43105 \u6c47\u603b sheet \u6821\u9a8c\u660e\u7ec6 sheet\uff1a\u53d1\u884c\u5408\u8ba1\u4e0e\u9000\u4f11\u5408\u8ba1\u5fc5\u987b\u4e00\u81f4\uff0c\u5426\u5219\u963b\u65ad\uff0c\u907f\u514d\u628a\u4e0d\u5b8c\u6574\u7684\u660e\u7ec6\u5199\u8fdb\u7d2f\u79ef\u53f0\u8d26\u3002",
      "operatorCode": "dataframe.sql.assert",
      "operatorVersion": "1.0.0"
    },
    {
      "x": 900,
      "y": 340,
      "id": "sum_series_b_outstanding",
      "name": "Sum SERIES B shares outstanding",
      "inputs": {
        "control_book": {
          "from": "merge_series_b_control_book",
          "slot": "dataframe",
          "guards": []
        }
      },
      "params": {
        "sql": "select coalesce(sum(coalesce([Shares Issued], 0)), 0) as [Shares Issued Total], coalesce(sum(coalesce([Shares Retired], 0)), 0) as [Shares Retired Total], coalesce(sum(coalesce([Shares Issued], 0)), 0) - coalesce(sum(coalesce([Shares Retired], 0)), 0) as [Shares Outstanding] from {control_book} where wf_month_key([As of Date]) is null or wf_month_key([As of Date]) <= {constants.workflowMonth}",
        "tableBindings": [
          {
            "inputSlot": "control_book",
            "tableName": "control_book"
          }
        ],
        "constants": {
          "workflowMonth": {
            "$type": "string",
            "$label": "Workflow month",
            "$fromRuntime": "month"
          }
        }
      },
      "dependsOn": [],
      "description": "\u5bf9\u7d2f\u79ef\u53f0\u8d26\u6309 As of Date \u622a\u65ad\u5230\u5de5\u4f5c\u6d41\u6708\u4efd\uff0c\u518d\u6c42 Shares Issued \u4e0e Shares Retired \u5408\u8ba1\u53ca\u51c0\u5728\u5916\u80a1\u6570\uff08Issued \u2212 Retired\uff09\u3002base \u4fdd\u7559\u5168\u90e8\u4ea4\u6613\uff08\u542b\u672a\u6765\u6708\u4efd\uff09\uff0c\u6240\u4ee5\u540c\u4e00\u4efd\u53f0\u8d26\u53ef\u56de\u7b97\u4efb\u610f\u5386\u53f2\u6708\u4efd\uff0c\u91cd\u8dd1 6/8 \u6708\u4e0d\u4f1a\u628a 9 \u6708\u624d\u751f\u6548\u7684\u9000\u4f11\u7b97\u8fdb\u53bb\u3002",
      "operatorCode": "sql.compute",
      "operatorVersion": "1.0.0"
    }
  ],

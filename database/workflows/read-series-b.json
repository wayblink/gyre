          "Security",
          "Process Date",
          "As of Date",
          "Transaction",
          "Reason",
          "Account Number",
          "Name",
          "Shares Issued",
          "Shares Retired"
        ],
        "sortColumns": [
          "As of Date",
          "Process Date",
          "Account Number"
        ],
        "conflictPolicy": "increment-wins",
        "incomingBlankPolicy": "preserve",
        "keyNormalization": {

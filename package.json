{
  "name": "gyre-captable",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "AUTH_DISABLED=true WORKFLOW_SEED_ON_INIT=true tsx watch src/server/server.ts",
    "dev:client": "vite --host 127.0.0.1 --port 60627",
    "db:up": "docker compose up -d postgres",
    "storage:up": "docker compose up -d minio",
    "infra:up": "docker compose up -d postgres minio",
    "db:down": "docker compose down",
    "build": "tsc -p tsconfig.json && vite build",
    "start": "WORKFLOW_SEED_ON_INIT=true node dist/src/server/server.js",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "workflow:publish-seed": "tsx src/server/workflow/publishWorkflowSeed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/multipart": "^8.3.0",
    "@fastify/static": "^7.0.4",
    "@univerjs/design": "^0.25.0",
    "@univerjs/preset-sheets-core": "^0.25.0",
    "@univerjs/presets": "^0.25.0",
    "@univerjs/sheets": "^0.25.0",
    "@univerjs/sheets-ui": "^0.25.0",
    "@univerjs/ui": "^0.25.0",
    "alasql": "^4.17.3",
    "fastify": "^4.28.1",
    "marked": "^12.0.2",
    "minio": "^8.0.7",
    "pg": "^8.13.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@types/pg": "^8.11.10",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "concurrently": "^9.1.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^8.10.2",
    "jsdom": "^25.0.1",
    "prettier": "^3.9.9",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^5.4.11"
  }
}

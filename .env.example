DATABASE_URL=postgres://captable:captable@127.0.0.1:55432/captable
HOST=127.0.0.1
PORT=60628
STORAGE_DRIVER=minio
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=29000
MINIO_HOST_PORT=29000
MINIO_CONSOLE_PORT=29001
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=captable-files

# ---- 认证 / 会话 ----
# true = 免登录（仅限本地开发）；false / 不设置 = 必须登录（默认，生产必须保持 false）
AUTH_DISABLED=false
# 空库首次创建管理员时，POST /api/auth/bootstrap 必须携带该口令；不设置则无法 bootstrap
AUTH_BOOTSTRAP_SECRET=
SESSION_COOKIE_NAME=captable_session
SESSION_TTL_HOURS=168
# HTTPS 部署设为 true（Cookie 仅走 Secure）；本地 http 开发设 false
SESSION_COOKIE_SECURE=false

# ---- 启动行为 ----
# true = 启动时补齐缺失的内置 workflow / operator / 全局参数种子（绝不覆盖 DB 已有行）
WORKFLOW_SEED_ON_INIT=true
